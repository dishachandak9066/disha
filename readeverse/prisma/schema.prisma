generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model book_chapters {
  id            Int       @id @default(autoincrement())
  bookId        Int
  chapterNumber Int
  title         String    @db.VarChar(255)
  content       String    @db.LongText
  wordCount     Int?      @default(0)
  createdAt     DateTime? @default(now()) @db.Timestamp(0)
  books         books     @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "book_chapters_ibfk_1")

  @@unique([bookId, chapterNumber], map: "unique_chapter")
  @@index([bookId], map: "idx_bookId")
}

model books {
  id            Int             @id @default(autoincrement())
  gutendexId    Int             @unique(map: "gutendexId")
  title         String          @db.VarChar(255)
  author        String          @db.VarChar(255)
  coverImage    String?         @db.Text
  language      String?         @default("en") @db.VarChar(10)
  subjects      Json?
  downloadCount Int?            @default(0)
  textUrl       String          @db.LongText
  totalChapters Int?            @default(0)
  totalWords    Int?            @default(0)
  createdAt     DateTime?       @default(now()) @db.Timestamp(0)
  updatedAt     DateTime?       @default(now()) @db.Timestamp(0)
  book_chapters book_chapters[]
  user_library  user_library[]

  @@index([author], map: "idx_author")
  @@index([gutendexId], map: "idx_gutendexId")
  @@index([title], map: "idx_title")
}

model user_library {
  id             Int       @id @default(autoincrement())
  userId         String    @db.VarChar(255)
  bookId         Int
  progress       Decimal?  @default(0.00) @db.Decimal(5, 2)
  currentChapter Int?      @default(0)
  lastReadAt     DateTime? @db.Timestamp(0)
  addedAt        DateTime? @default(now()) @db.Timestamp(0)
  books          books     @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_library_ibfk_1")

  @@unique([userId, bookId], map: "unique_user_book")
  @@index([bookId], map: "bookId")
  @@index([userId], map: "idx_userId")
}
